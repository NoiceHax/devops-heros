{
 "uid": "s20-overview",
 "title": "Session 20: Host and App Overview",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "tags": [
  "session20"
 ],
 "panels": [
  {
   "id": 3,
   "type": "stat",
   "title": "App health (1 = up)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "probe_success{job=\"app-health\"}",
     "legendFormat": "{{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "min": 0,
     "max": 1,
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN",
         "color": "red"
        },
        "1": {
         "text": "UP",
         "color": "green"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "HTTP probe latency",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 18,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "probe_duration_seconds{job=\"app-health\"}",
     "legendFormat": "{{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0
    },
    "overrides": []
   }
  },
  {
   "id": 1,
   "type": "timeseries",
   "title": "CPU utilization (%)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[30s])) * 100)",
     "legendFormat": "cpu"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Memory utilization (%)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 7,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100",
     "legendFormat": "memory"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Scrape targets up",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "up",
     "legendFormat": "{{job}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "min": 0,
     "max": 1
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Prometheus samples ingested /s",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 14,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(prometheus_tsdb_head_samples_appended_total[1m])",
     "legendFormat": "samples/s"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "min": 0
    },
    "overrides": []
   }
  }
 ]
}